{
  "name": "@alanizcreative/formation-docs",
  "version": "0.0.3",
  "description": "Utilities to generate docs from JSDoc comments in TypeScript or JavaScript files",
  "main": "./lib/docs.js",
  "packageManager": "pnpm@11.15.0",
  "type": "module",
  "files": [
    "./lib"
  ],
  "exports": {
    "./*": {
      "import": "./lib/*"
    }
  },
  "scripts": {
    "build": "npx tsc --project tsconfig.build.json && pnpm minify",
    "minify": "find lib -name \"*.js\" -exec terser {} -o {} --compress \\;",
    "lint": "npx eslint .",
    "test": "vitest --run --reporter verbose --coverage"
  },
  "keywords": [
    "jsdoc",
    "docs",
    "typescript",
    "javascript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/galaniz/formation-docs.git"
  },
  "bugs": {
    "url": "https://github.com/galaniz/formation-docs/issues"
  },
  "homepage": "https://github.com/galaniz/formation-docs#readme",
  "author": "Graciela Alaniz (https://alanizcreative.com/)",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@shikijs/transformers": "4.3.1",
    "glob": "13.0.6",
    "jsdoc-api": "^9.3.6",
    "shiki": "4.3.1",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@typescript-eslint/eslint-plugin": "8.64.0",
    "@typescript-eslint/parser": "8.64.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "terser": "5.49.0",
    "typescript-eslint": "8.64.0",
    "vitest": "^4.1.10"
  },
  "release-it": {
    "git": {
      "requireCommits": true,
      "commitMessage": "chore: release ${version} [ci skip]",
      "tag": true,
      "push": true
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": true,
      "skipChecks": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
