{
  "name": "@alanizcreative/formation-docs",
  "version": "0.0.2",
  "description": "Utilities to generate docs from JSDoc comments in TypeScript or JavaScript files",
  "main": "./lib/docs.js",
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "files": [
    "./lib"
  ],
  "exports": {
    "./*": {
      "import": "./lib/*"
    }
  },
  "scripts": {
    "build": "npx tsc --project tsconfig.build.json && pnpm minify",
    "minify": "find lib -name \"*.js\" -exec terser {} -o {} --compress \\;",
    "lint": "npx eslint .",
    "test": "vitest --run --reporter verbose --coverage",
    "release": "release-it"
  },
  "keywords": [
    "jsdoc",
    "docs",
    "typescript",
    "javascript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/galaniz/formation-docs.git"
  },
  "bugs": {
    "url": "https://github.com/galaniz/formation-docs/issues"
  },
  "homepage": "https://github.com/galaniz/formation-docs#readme",
  "author": "Graciela Alaniz (https://alanizcreative.com/)",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "flatted@<3.4.0": ">=3.4.0",
      "flatted@<=3.4.1": ">=3.4.2",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "underscore@<=1.13.7": ">=1.13.8",
      "undici": ">=7.24.0",
      "brace-expansion@<5.0.5": ">=5.0.5"
    }
  },
  "dependencies": {
    "@shikijs/transformers": "4.0.2",
    "glob": "13.0.6",
    "jsdoc-api": "^9.3.5",
    "shiki": "4.0.2",
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "@typescript-eslint/eslint-plugin": "8.57.2",
    "@typescript-eslint/parser": "8.57.2",
    "@vitest/coverage-v8": "^4.1.1",
    "eslint": "^10.1.0",
    "release-it": "^19.2.4",
    "terser": "5.46.1",
    "typescript-eslint": "8.57.2",
    "vitest": "^4.1.1"
  },
  "release-it": {
    "git": {
      "requireCommits": true,
      "commitMessage": "chore: release ${version} [ci skip]",
      "tag": true,
      "push": true
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": true,
      "skipChecks": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
